# Konfigurasi NON-SECRET (dibaca dari environment variable; file ini hanya contoh).
# Jangan pernah menaruh key kriptografi di sini: key dibuat otomatis dan disimpan di Windows Credential Manager.
SENTINEL_DATA_DIR=D:\SENTINEL_DATA
DEEPFACE_HOME=D:\DevCache\deepface
SENTINEL_MAX_FILE_MB=100
SENTINEL_CAMERA_INDEX=0
SENTINEL_THEME=dark
# Isi 1 hanya jika flash drive Anda dilaporkan Windows sebagai "fixed disk" dan tidak terdeteksi.
SENTINEL_USB_INCLUDE_FIXED=0
